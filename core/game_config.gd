const ORBIT_HIT_RADIUS := 13.0      # 单个环绕物的碰撞半径
const ORBIT_FLASH := 0.10

# ---- 刷怪 ----
# 场上敌人数随时间增长：开局 25 只，20 分钟到 800（技术方案里的峰值目标）
#
# 开局预铺的敌人用一组更近的距离（SPAWN_START_*），不用常规刷怪距离。
# 因为常规距离是"屏幕外 430px"，敌人速度 52、长鞭射程只有 110，
