const ARENA_EDGE_WARN := 240.0

# ---- 敌人 ----
# 基础血量必须低于起始武器的一发伤害（分支长鞭 Lv1 = 12），否则开局砍两刀才死。
# 第一刀打上去敌人只闪一下白、什么都没发生，主观感受就是"攻击没效果"。
# 幸存者品类的开局正反馈全靠一刀一个，这一条优先于任何数值平衡考虑。
const ENEMY_HP := 10.0
const ENEMY_SPEED := 52.0
const ENEMY_RADIUS := 7.0
const ENEMY_TOUCH_DAMAGE := 8.0
# 血量随存活时长线性成长，否则后期一刀一片、难度曲线是平的。
#
# 0.0065 → 0.008：真人试玩反馈"10 分钟后无法秒杀敌人，但也很轻松就能通关"。
# 血量成长决定"后期一屏敌人要打多久"，0.0065 时后期还是扫一眼就空。
# 试过 0.011 连会走位的 AI 都撑不过 5 分钟（上一轮的教训），0.008 是中间档：
# 10 分钟 ×5.8 倍（58 血）、20 分钟 ×10.6 倍（106 血）—— 中期怪要 2~3 鞭，
# 后期开始出现"打不过就绕着走"的选择。
const ENEMY_HP_GROWTH := 0.008      # 10 分钟 ×5.8 倍（58 血），20 分钟 ×10.6 倍（106 血）

# ---- 分离（防止敌人完全重叠）----
# 两层上限，缺一不可（实测：少了候选上限，1600 敌人时每帧要 69ms）：
#   SEP_MAX_CHECKS    —— 最多"检查"多少个候选。敌群密集时一个格子里可能有上百个
#                        实体，不设上限就会全部遍历一遍，这是性能塌陷的主因。
#   SEP_MAX_NEIGHBORS —— 最多对多少个邻居施加推力。控制视觉密度，也稳定单帧耗时。
const SEP_MAX_CHECKS := 12
const SEP_MAX_NEIGHBORS := 6
const SEP_RANGE := 20.0
const SEP_FORCE := 130.0

