# ---- 经验宝石 ----
const GEM_RADIUS := 5.0
# 70 时实测拾取率只有击杀数的 30% —— 一局 2.5 万杀只吃到 7 千个，
# 地面残留长期顶满宝石池（4096），等于大半经验白打。
# 放宽到 95 后拾取率抬到 50% 上下，玩家不必刻意绕路回头捡。
const PICKUP_RANGE := 95.0          # 基础拾取半径（会被"磁吸指针"被动放大）
