# 玩家的第一印象就是"这游戏没反应"。预铺的最近一批 2.7 秒就能接火。
const START_ENEMIES := 22
const SPAWN_START_MIN := 210.0
const SPAWN_START_MAX := 400.0

const SPAWN_MIN_DIST := 430.0        # 屏幕外生成，不要凭空出现在眼前
const SPAWN_MAX_DIST := 620.0

